# Copy to .env.local for local development. On Vercel, set these in the web project's settings.

# Base URL of the Case Desk API. Only the Next.js server calls it.
API_URL=http://127.0.0.1:8000

# Shows the one-click demo sign in and the demo banner. Match the API's DEMO_MODE.
DEMO_MODE=true

# MUI X Pro license (DataGrid Pro). MUI validates it in the browser, so it ships in the
# bundle by design. Without it the grids show a "missing license" watermark.
NEXT_PUBLIC_MUI_X_LICENSE_KEY=
