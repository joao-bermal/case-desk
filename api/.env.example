# Copy to .env for local development. On Vercel, set these in the API project's settings.

# Postgres. Locally: the docker compose service. In production: the pooled connection URL.
DATABASE_URL=postgresql+psycopg://casedesk:casedesk@localhost:5433/casedesk

# Base URL of the web app, used in invite and password reset links.
WEB_BASE_URL=http://localhost:3000

# Public demo: one-click sign in per role, daily reset, row caps. Leave SMTP empty in the demo.
DEMO_MODE=true
# Any long random string. Vercel Cron sends it to GET /demo/reset as a bearer token.
CRON_SECRET=

# Email. Locally, Mailpit catches everything at http://localhost:8025.
# Without SMTP_HOST the emails are written to the log instead.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Case Desk <no-reply@casedesk.example>
